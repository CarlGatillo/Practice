package Gatillo;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.io.*;
import java.awt.*;

public class PayrollSystem extends JFrame {

    private final JTextField idField = new JTextField();
    private final JTextField nameField = new JTextField();
    private final JTextField positionField = new JTextField();
    private final JTextField hoursField = new JTextField();
    private final JTextField rateField = new JTextField();
    private final JTextField salaryField = new JTextField();
    private final JTextField payDateField = new JTextField();

    private final String[] columns = {"Employee ID","Employee Name","Position","Hours Worked","Hourly Rate","Total Salary","Pay Date"};
    private final DefaultTableModel model = new DefaultTableModel(columns, 0);
    private final JTable table = new JTable(model);

    private final String FILE = "payroll.txt";

    public PayrollSystem() {

        setTitle("Employee Payroll Record System");
        setSize(900, 550);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLayout(new BorderLayout(10, 10));
        setLocationRelativeTo(null);

        add(new JScrollPane(table), BorderLayout.CENTER);

        table.getSelectionModel().addListSelectionListener(e -> fillFields());

        JPanel inputs = new JPanel(new GridLayout(7, 2, 5, 5));
        inputs.setBorder(BorderFactory.createTitledBorder("Payroll Details"));

        inputs.add(new JLabel("Employee ID"));
        inputs.add(idField);
        inputs.add(new JLabel("Employee Name"));
        inputs.add(nameField);
        inputs.add(new JLabel("Position"));
        inputs.add(positionField);
        inputs.add(new JLabel("Hours Worked"));
        inputs.add(hoursField);
        inputs.add(new JLabel("Hourly Rate"));
        inputs.add(rateField);
        inputs.add(new JLabel("Total Salary"));
        salaryField.setEditable(false);
        inputs.add(salaryField);
        inputs.add(new JLabel("Pay Date"));
        inputs.add(payDateField);

        JPanel buttons = new JPanel();
        addButton(buttons, "Add", e -> addRecord());
        addButton(buttons, "Update", e -> updateRecord());
        addButton(buttons, "Delete", e -> deleteRecord());
        addButton(buttons, "Clear", e -> clearFields());
        addButton(buttons, "Exit", e -> System.exit(0));

        JPanel bottom = new JPanel(new BorderLayout());
        bottom.add(inputs, BorderLayout.CENTER);
        bottom.add(buttons, BorderLayout.SOUTH);
        add(bottom, BorderLayout.SOUTH);

        loadFromFile();
    }

    private void addButton(JPanel p, String name, java.awt.event.ActionListener a) {
        JButton b = new JButton(name);
        b.addActionListener(a);
        p.add(b);

    }

    private Object[] readFields() {

        String id = idField.getText().trim();
        String empName = nameField.getText().trim();
        String position = positionField.getText().trim();
        String hours = hoursField.getText().trim();
        String rate = rateField.getText().trim();
        String payDate = payDateField.getText().trim();

        if (id.isEmpty() || empName.isEmpty() || position.isEmpty()|| hours.isEmpty() || rate.isEmpty() || payDate.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Please fill all fields.");
            return null;
        }

        try {
            double hrs = Double.parseDouble(hours);
            double hourlyRate = Double.parseDouble(rate);
            double totalSalary = hrs * hourlyRate;
            salaryField.setText(String.valueOf(totalSalary));
            return null;
             
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this,"Hours Worked and Hourly Rate must be numeric.");
            return null;
        }
    }
    private void addRecord() {

        Object[] row = readFields();
        if (row != null) {
            model.addRow(row);
            saveToFile();
            clearFields();
        }
    }

    private void updateRecord() {
        int row = table.getSelectedRow();
        if (row == -1) {
            JOptionPane.showMessageDialog(this,"Please select a record.");
            return;
        }

        Object[] newRow = readFields();
        if (newRow != null) {
            model.removeRow(row);
            model.insertRow(row, newRow);
            saveToFile();
            clearFields();
        }

    }
    private void deleteRecord() {
        int row = table.getSelectedRow();
        if (row == -1) {
            JOptionPane.showMessageDialog(this, "Please select a record.");
            return;
        }
        model.removeRow(row);
        saveToFile();
        clearFields();
    }

    private void clearFields() {

        idField.setText("");
        nameField.setText("");
        positionField.setText("");
        hoursField.setText("");
        rateField.setText("");
        salaryField.setText("");
        payDateField.setText("");

    }

    private void fillFields() {
        int row = table.getSelectedRow();
        if (row == -1) {
            return;
        }

        idField.setText(model.getValueAt(row, 0).toString());
        nameField.setText(model.getValueAt(row, 1).toString());
        positionField.setText(model.getValueAt(row, 2).toString());
        hoursField.setText(model.getValueAt(row, 3).toString());
        rateField.setText(model.getValueAt(row, 4).toString());
        salaryField.setText(model.getValueAt(row, 5).toString());
        payDateField.setText(model.getValueAt(row, 6).toString());

    }

    private void saveToFile() {
        try (PrintWriter write = new PrintWriter(new FileWriter(FILE))) {
            for (int i = 0; i < model.getRowCount(); i++) {
                write.println(model.getValueAt(i, 0) + "," 
                      + model.getValueAt(i, 1) + "," 
                      + model.getValueAt(i, 2) + "," 
                      + model.getValueAt(i, 3) + "," 
                      + model.getValueAt(i, 4) + "," 
                      + model.getValueAt(i, 5) + "," 
                      + model.getValueAt(i, 6)
                );
            }
        } catch (IOException ex) {
            JOptionPane.showMessageDialog(this,"Error Saving File: " + ex.getMessage());
        }

    }

    private void loadFromFile() {
        File file = new File(FILE);
        if (!file.exists()) {
            return;
        }
        try (BufferedReader read = new BufferedReader(new FileReader(file))) {
            String line;
            while ((line = read.readLine()) != null) {
                String[] parts = line.split(",");
                if (parts.length == 7) {
                    model.addRow(parts);
                }

            }

        } catch (IOException ex) {
            JOptionPane.showMessageDialog(this,
                    "Error Loading File: " + ex.getMessage());
        }

    }
    public static void main(String[] args) {
       new PayrollSystem().setVisible(true);

    }

}
