package SessionTest;

public class OOP {

    static class Book {
        String title;
        String author;
        double price;

        Book(String title, String author, double price) {
            this.title = title;
            this.author = author;
            this.price = price;
        }

        void displayInfo() {
            System.out.println("Title:  " + title);
            System.out.println("Author: " + author);
            System.out.println("Price:  " + price);
            System.out.println("------------------------");
        }
    }

    public static void main(String[] args) {

        Book book1 = new Book("Java Basics", "Juan Dela Cruz", 250.00);
        Book book2 = new Book("Learning GUI", "Maria Santos", 300.00);

        book1.displayInfo();
        book2.displayInfo();

        book1.price = 199.00;
        System.out.println("After a price change:");
        book1.displayInfo();
        book2.displayInfo();
    }
}
